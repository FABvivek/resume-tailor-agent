# -------------------------------------------------------------
# LLM Provider Configuration
# Choose one of: ollama | gemini | openai | mistral
# -------------------------------------------------------------
LLM_PROVIDER=ollama

# Ollama settings (Local default - zero cost, runs locally)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest

# Cloud provider keys (Optional: set if switching LLM_PROVIDER)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Database configuration (Postgres-ready via DATABASE_URL)
DATABASE_URL=sqlite:///./resume_tailor.db

# Storage settings
UPLOAD_DIR=./uploads

# Agent Budget Controls
MAX_STEPS=8
MAX_SESSION_TOKENS=16000

# Verifier settings
ENABLE_LLM_VERIFIER=false
